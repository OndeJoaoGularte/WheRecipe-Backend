# Node
TZ=UTC
PORT=3333
HOST=0.0.0.0
NODE_ENV=development

# App (optional on Render — defaults are applied in start/env.ts)
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Database — on Render you can set ONLY DATABASE_URL (Neon).
# Locally, sqlite works without DATABASE_URL.
DB_CONNECTION=sqlite
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=wherecipe
DB_PASSWORD=wherecipe
DB_DATABASE=wherecipe

# Typesense (optional)
TYPESENSE_HOST=127.0.0.1
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=wherecipe-typesense-key

# CORS (optional — if empty, any origin is allowed, like Express cors())
CORS_ORIGIN=http://localhost:3000

