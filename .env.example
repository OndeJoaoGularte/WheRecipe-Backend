# Node
TZ=UTC
PORT=3333
HOST=0.0.0.0
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Database (postgres | sqlite). Use sqlite without Docker; postgres with compose.
DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=wherecipe
DB_PASSWORD=wherecipe
DB_DATABASE=wherecipe

# Typesense
TYPESENSE_HOST=127.0.0.1
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=wherecipe-typesense-key

# CORS
CORS_ORIGIN=http://localhost:3000
